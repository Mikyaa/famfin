Options -Indexes

<FilesMatch "\.(sql|md|sqlite|sqlite3|db|log|example|json|lock)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(config(\.example)?\.php|lib\.php|router\.php|polling\.php|weekly_report\.php|report_image\.php|widget_update\.php|features\.php|bot\.php|backup\.php|daily\.php|statement_worker\.php|extras\.php|import_statement\.php|\.gitignore|\.env.*)$">
  Require all denied
</FilesMatch>

RedirectMatch 403 ^/storage(/|$)
RedirectMatch 403 ^/tools(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
